-- =======================================================================================
-- Real Time Zone (RTZ) - Real-Time Resting & Campfire Rest Module
-- Addon for Seasons of the Zone by Denis_Zedd
-- =======================================================================================

GUI = nil
is_resting = false
local rest_start_tg = 0
local last_rest_tick_tg = 0
local initial_rest_fatigue = 0
local current_rest_fatigue = 0
local rest_source = "bed" -- "bed", "sleepbag", "campfire"
local rest_forced = false
local FORCED_LOCK_MS = 30000 -- 30s unskippable penalty window on exhaustion blackout (sleep_forced)
local mus_vol_saved = nil
local amb_vol_saved = nil
local last_health = 1.0

local last_campfire_tick = 0
local CAMPFIRE_TICK_MS = 1500

local function printf_rtz(fmt, ...)
    printf("[RTZ Rest] " .. fmt, ...)
end

--- Safely reads the actor's current fatigue (0 .. 10000)
function get_actor_fatigue()
    if actor_status_sleep and actor_status_sleep.get_last_sleep then
        return actor_status_sleep.get_last_sleep() or 0
    end
    return 0
end

--- Safely updates the local `last_sleep` upvalue inside actor_status_sleep.script
function set_actor_fatigue(val)
    val = math.max(0, math.min(10000, math.floor(val + 0.5)))
    pcall(function()
        if actor_status_sleep then
            if actor_status_sleep.load_state then
                local chk = (utils_data and utils_data.CTime_to_table and game.get_game_time)
                    and utils_data.CTime_to_table(game.get_game_time()) or nil
                actor_status_sleep.load_state({
                    sleep = {
                        last_sleep = val,
                        chk_sleep = chk,
                    }
                })
            end
            if alife_storage_manager and alife_storage_manager.get_state then
                local st = alife_storage_manager.get_state()
                if st and st.sleep then
                    st.sleep.last_sleep = val
                end
            end
            if actor_status_sleep.test_blur then
                actor_status_sleep.test_blur()
            end
        end
    end)
end

--- Checks if actor is near an active, lit campfire
function get_nearby_lit_campfire(dist)
    if not db.actor then return false end
    dist = dist or 3.5
    local pos = db.actor:position()

    if bind_campfire and bind_campfire.campfires_all then
        for id, binder in pairs(bind_campfire.campfires_all) do
            if binder and binder.object and binder.campfire and binder.campfire:is_on() then
                if pos:distance_to_sqr(binder.object:position()) <= (dist * dist) then
                    return true
                end
            end
        end
    end
    return false
end

-- =======================================================================================
-- UI Rest Window
-- =======================================================================================
class "UIRtzRest" (CUIScriptWnd)

function UIRtzRest:__init(source) super()
    self.source = source or "bed"
    self:InitControls()
    self:InitCallbacks()
end

function UIRtzRest:__finalize()
    GUI = nil
end

function UIRtzRest:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_rtz_rest.xml")

    self.back = xml:InitStatic("background", self)
    self.panel = xml:InitStatic("center_panel", self)
    self.frame = xml:InitFrame("center_panel:frame", self.panel)
    self.title = xml:InitTextWnd("center_panel:title", self.panel)
    self.time_text = xml:InitTextWnd("center_panel:time_text", self.panel)
    self.status_text = xml:InitTextWnd("center_panel:status_text", self.panel)
    self.comfort_text = xml:InitTextWnd("center_panel:comfort_text", self.panel)

    self.prog_back = xml:InitStatic("center_panel:progress_back", self.panel)
    self.prog_bar = xml:InitProgressBar("center_panel:progress_bar", self.panel)

    self.btn_wake = xml:Init3tButton("center_panel:btn_wake", self.panel)
    self:Register(self.btn_wake, "btn_wake")

    self.hint_text = xml:InitTextWnd("center_panel:hint_text", self.panel)

    -- Initial strings
    self.title:SetText(game.translate_string("st_rtz_resting"))
    self.hint_text:SetText(game.translate_string("st_rtz_rest_hint"))
    if self.btn_wake and self.btn_wake.TextControl then
        self.btn_wake:TextControl():SetText(game.translate_string("st_rtz_btn_wake"))
    end

    if self.source == "bed" then
        self.comfort_text:SetText(game.translate_string("st_rtz_rest_comfort_bed"))
    elseif self.source == "sleepbag" then
        self.comfort_text:SetText(game.translate_string("st_rtz_rest_comfort_sleepbag"))
    else
        self.comfort_text:SetText(game.translate_string("st_rtz_rest_comfort_campfire"))
    end
end

function UIRtzRest:InitCallbacks()
    self:AddCallback("btn_wake", ui_events.BUTTON_CLICKED, self.OnButtonWake, self)
end

local function is_forced_lock_active()
    return is_resting and rest_forced and (time_global() < rest_start_tg + FORCED_LOCK_MS)
end

function UIRtzRest:OnButtonWake()
    if is_forced_lock_active() then return end
    stop_resting(false)
end

function UIRtzRest:Close()
    if is_forced_lock_active() then return end
    stop_resting(false)
end

function UIRtzRest:OnKeyboard(dik, keyboard_action)
    local res = CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)
    if (res == false) and (keyboard_action == ui_events.WINDOW_KEY_PRESSED) then
        if dik == DIK_keys.DIK_ESCAPE or dik == DIK_keys.DIK_SPACE or dik == DIK_keys.DIK_RETURN then
            if is_forced_lock_active() then
                return true
            end
            stop_resting(false)
            return true
        end
    end
    return res
end

function UIRtzRest:Update()
    CUIScriptWnd.Update(self)
    if not is_resting then return end

    if self.btn_wake then
        self.btn_wake:Show(not is_forced_lock_active())
    end

    local real = os.date("*t")
    if real and self.time_text then
        local t_str = string.format("%02d:%02d:%02d", real.hour, real.min, real.sec)
        self.time_text:SetText(t_str)
    end

    local current_fatigue = get_actor_fatigue()

    -- Percentage: 0 is fully rested, 8000+ is full exhaustion
    local fatigue_pct = math.floor(math.min(100, math.max(0, (current_fatigue / 8000) * 100)))
    if self.status_text then
        self.status_text:SetText(string.format(game.translate_string("st_rtz_rest_fatigue_recovering"), fatigue_pct))
    end

    if self.prog_bar then
        local rest_progress = math.max(0, math.min(100, 100 - fatigue_pct))
        self.prog_bar:SetProgressPos(rest_progress)
    end
end

-- =======================================================================================
-- Resting Controller
-- =======================================================================================

local function clear_sleep_infoportions()
    if disable_info then
        disable_info("actor_is_sleeping")
        disable_info("sleep_active")
        disable_info("force_slp2")
    end
end

function restore_saved_volumes()
    if mus_vol_saved then
        exec_console_cmd("snd_volume_music " .. tostring(mus_vol_saved))
        mus_vol_saved = nil
    end
    if amb_vol_saved then
        exec_console_cmd("snd_volume_eff " .. tostring(amb_vol_saved))
        amb_vol_saved = nil
    end
end

function start_resting(source, force)
    if is_resting then return end
    if not db.actor then
        clear_sleep_infoportions()
        return
    end

    local current_slp = get_actor_fatigue()
    local is_forced = (force == true)

    -- Respect GAMMA & Anomaly UISleep:TestAndShow conditions when not forced
    if not is_forced then
        local min_slp = (item_tent ~= nil) and 5000 or 1500
        if current_slp < min_slp then
            local msg_id = (item_tent ~= nil) and "st_sleep_awake" or "st_rtz_awake"
            actor_menu.set_msg(1, game.translate_string(msg_id), 4)
            clear_sleep_infoportions()
            return
        end

        local bleeding = (db.actor.bleeding or 0) > 0
        local radiation = (db.actor.radiation or 0) > 0
        if bleeding or radiation then
            if bleeding and radiation then
                actor_menu.set_msg(1, game.translate_string("st_sleep_bleeding_irradiated"), 5)
            elseif bleeding then
                actor_menu.set_msg(1, game.translate_string("st_sleep_bleeding"), 4)
            elseif radiation then
                actor_menu.set_msg(1, game.translate_string("st_sleep_irradiated"), 4)
            end
            clear_sleep_infoportions()
            return
        end

        if item_tent ~= nil then
            local actor_hide = (GetEvent and GetEvent("current_safe_cover")) and true or false
            if (not actor_hide) and item_tent.get_nearby_tent then
                actor_hide = item_tent.get_nearby_tent(1.5)
            end
            if not actor_hide then
                actor_menu.set_msg(1, game.translate_string("st_cant_sleep_find_shelter_mlr"), 4)
                clear_sleep_infoportions()
                return
            end
        end
    end

    if current_slp < 150 then
        current_slp = 1500
    end

    is_resting = true
    rest_source = source or "bed"
    rest_forced = is_forced
    rest_start_tg = time_global()
    last_rest_tick_tg = rest_start_tg
    initial_rest_fatigue = current_slp
    current_rest_fatigue = current_slp
    last_health = db.actor.health or 1.0

    -- Close inventory if open and holsters weapon without disabling UI input
    if hide_hud_inventory then
        hide_hud_inventory()
    end
    db.actor:activate_slot(0)
    db.actor:give_info_portion("actor_is_sleeping")

    -- Mute music while resting
    mus_vol_saved = get_console_cmd(2, "snd_volume_music")
    amb_vol_saved = get_console_cmd(2, "snd_volume_eff")
    exec_console_cmd("snd_volume_music 0")

    -- Screen fade effector
    level.add_pp_effector("sleep_fade.ppe", 8888, false)
    level.add_cam_effector("camera_effects\\sleep.anm", 8889, false, "")

    -- Show Rest GUI and register with Anomaly UI manager so mouse/keyboard work cleanly
    GUI = UIRtzRest(rest_source)
    GUI:ShowDialog(true)
    if Register_UI then
        Register_UI("UIRtzRest", "rtz_rest")
    end

    printf_rtz("Started real-time rest (%s), initial fatigue: %d", rest_source, current_slp)
end

function stop_resting(interrupted)
    if not is_resting then return end
    is_resting = false
    rest_forced = false

    -- Close GUI and unregister
    if GUI then
        if GUI:IsShown() then
            GUI:HideDialog()
        end
        GUI = nil
    end
    if Unregister_UI then
        Unregister_UI("UIRtzRest")
    end

    -- Restore effectors & volume
    level.remove_pp_effector(8888)
    level.remove_cam_effector(8889)
    restore_saved_volumes()

    clear_sleep_infoportions()

    local end_fatigue = get_actor_fatigue()

    -- Notify player
    if interrupted then
        actor_menu.set_msg(1, game.translate_string("st_rtz_rest_interrupted"), 4)
    else
        if end_fatigue <= 150 then
            end_fatigue = 0
            set_actor_fatigue(0)
            actor_menu.set_msg(1, game.translate_string("st_rtz_rest_fully_rested"), 4)
        else
            actor_menu.set_msg(1, game.translate_string("st_rtz_rest_woke_up"), 4)
        end

    end

    -- Compute equivalent sleep hours (up to 8 hours for a full 8000 fatigue recovery)
    -- so Body Health System (zzz_player_injuries) heals limbs and arszi_psy regenerates psy-health,
    -- while guarding hunger, thirst, sleep fatigue, and surge_manager's forced_weather_change
    local recovered = math.max(0, (initial_rest_fatigue or end_fatigue) - end_fatigue)
    local equiv_hours = math.max(0, math.floor((recovered / 8000) * 8 + 0.5))

    local snap_sat = db.actor and db.actor.satiety or nil
    local snap_drk = (actor_status_thirst and actor_status_thirst.get_last_drink and actor_status_thirst.get_last_drink()) or nil

    local wmgr = level_weathers and level_weathers.get_weather_manager and level_weathers.get_weather_manager()
    local org_forced_weather_change = wmgr and wmgr.forced_weather_change
    if wmgr and org_forced_weather_change then
        wmgr.forced_weather_change = function() end
    end

    local sm = surge_manager and surge_manager.get_surge_manager and surge_manager.get_surge_manager()
    local pm = psi_storm_manager and psi_storm_manager.get_psi_storm_manager and psi_storm_manager.get_psi_storm_manager()
    local sm_tf = sm and sm.time_forwarded
    local pm_tf = pm and pm.time_forwarded

    if rtz_clock then
        rtz_clock.is_in_sleep_callback = true
    end

    SendScriptCallback("actor_on_sleep", equiv_hours)

    if rtz_clock then
        rtz_clock.is_in_sleep_callback = false
    end
    if wmgr and org_forced_weather_change then
        wmgr.forced_weather_change = org_forced_weather_change
    end
    if sm then sm.time_forwarded = sm_tf end
    if pm then pm.time_forwarded = pm_tf end

    pcall(function()
        set_actor_fatigue(end_fatigue)
        if db.actor and snap_sat ~= nil and db.actor.satiety ~= nil then
            db.actor.satiety = snap_sat
        end
        if actor_status_thirst and snap_drk ~= nil and actor_status_thirst.load_state then
            local chk = (utils_data and utils_data.CTime_to_table and game.get_game_time)
                and utils_data.CTime_to_table(game.get_game_time()) or nil
            actor_status_thirst.load_state({
                drink = {
                    last_drink = snap_drk,
                    chk_drink = chk,
                }
            })
        end
    end)

    -- Autosave after the sleep handlers so the save includes this rest's healing
    if not interrupted and rtz_mcm.get_config("autosave_on_rest") then
        exec_console_cmd("save " .. (user_name() or "stalker") .. " - rest")
    end

    printf_rtz("Finished rest (equiv_hours=%d), interrupted: %s", equiv_hours, tostring(interrupted))
end

--- Tears down the rest state/dialog without running sleep handlers (load, death, level change)
function abort_resting()
    if not is_resting and not GUI then return end
    is_resting = false
    rest_forced = false
    if GUI then
        pcall(function()
            if GUI:IsShown() then
                GUI:HideDialog()
            end
        end)
        GUI = nil
    end
    if Unregister_UI then
        pcall(Unregister_UI, "UIRtzRest")
    end
    pcall(function()
        level.remove_pp_effector(8888)
        level.remove_cam_effector(8889)
    end)
    restore_saved_volumes()
    clear_sleep_infoportions()
end

--- Frame-independent update loop during active rest
function update_active_rest()
    if not is_resting or not db.actor then return end

    local tg = time_global()
    if tg < last_rest_tick_tg + 100 then
        return
    end
    local dt = math.min(1.0, (tg - last_rest_tick_tg) / 1000.0)
    last_rest_tick_tg = tg

    -- Check damage / danger interrupt
    if rtz_mcm.get_config("wake_on_danger") then
        local cur_health = db.actor.health or 1.0
        if (last_health - cur_health) > 0.02 or (db.actor.bleeding and db.actor.bleeding > 0.1) then
            stop_resting(true)
            return
        end
        last_health = cur_health
    end

    -- Recovery calculation (8000 fatigue recovered over `rest_duration` real minutes, converted to seconds)
    local cfg_duration = rtz_mcm.get_config("rest_duration") or 5
    local total_duration = (cfg_duration <= 20) and (cfg_duration * 60) or 300
    local mult = (rest_source == "bed") and 1.3 or ((rest_source == "sleepbag") and 1.0 or 0.6)
    local recovery_per_sec = (8000 / math.max(60, total_duration)) * mult

    current_rest_fatigue = math.max(0, current_rest_fatigue - (recovery_per_sec * dt))
    set_actor_fatigue(current_rest_fatigue)

    -- Restore stamina & gentle health regen while resting
    if db.actor.power then db.actor.power = 1.0 end
    db.actor:change_health(0.002 * dt)

    if current_rest_fatigue <= 25 then
        set_actor_fatigue(0)
        stop_resting(false)
        return
    end
end

--- Campfire Passive Rest Tick
function update_campfire_rest()
    if is_resting then return end
    if not rtz_mcm.get_config("enabled") or not rtz_mcm.get_config("enable_campfire_rest") then
        return
    end

    local tg = time_global()
    if tg < last_campfire_tick + CAMPFIRE_TICK_MS then return end
    local dt = math.min(5.0, (tg - last_campfire_tick) / 1000.0)
    last_campfire_tick = tg

    if get_nearby_lit_campfire(4.0) then
        local cfg_duration = rtz_mcm.get_config("rest_duration") or 5
        local total_duration = (cfg_duration <= 20) and (cfg_duration * 60) or 300
        local sleepbag_rate = 8000 / math.max(60, total_duration)
        -- Guarantee campfire rest is always slower than a sleeping bag or bed
        local rate = math.min(rtz_mcm.get_config("campfire_rest_rate") or 6, sleepbag_rate * 0.65)
        local delta = rate * dt
        local cur_slp = get_actor_fatigue()
        if cur_slp > 100 then
            set_actor_fatigue(math.max(100, cur_slp - delta))
        end
    end
end

-- =======================================================================================
-- Sleep Dialog Interception
-- =======================================================================================
local hooks_installed = false

local function install_sleep_hooks()
    if hooks_installed then return end
    if not ui_sleep_dialog then return end

    -- Hook normal bed sleep
    local org_sleep = ui_sleep_dialog.sleep
    ui_sleep_dialog.sleep = function(force)
        if rtz_mcm.get_config("enabled") and rtz_mcm.get_config("enable_realtime_rest") then
            start_resting("bed", force)
            return
        end
        return org_sleep(force)
    end

    -- Hook sleeping bag sleep
    local org_sleep_bag = ui_sleep_dialog.sleep_bag
    ui_sleep_dialog.sleep_bag = function(ph_sleepbag_id, sec)
        if rtz_mcm.get_config("enabled") and rtz_mcm.get_config("enable_realtime_rest") then
            start_resting("sleepbag", false)
            return
        end
        return org_sleep_bag(ph_sleepbag_id, sec)
    end

    -- Hook forced sleep (blackout from exhaustion)
    if ui_sleep_dialog.sleep_forced then
        local org_sleep_forced = ui_sleep_dialog.sleep_forced
        ui_sleep_dialog.sleep_forced = function(hours)
            if rtz_mcm.get_config("enabled") and rtz_mcm.get_config("enable_realtime_rest") then
                start_resting("bed", true)
                return
            end
            return org_sleep_forced(hours)
        end
    end

    -- Hook UISleep.TestAndShow in case external mods invoke UISleep directly
    if ui_sleep_dialog.UISleep and ui_sleep_dialog.UISleep.TestAndShow then
        local org_test_and_show = ui_sleep_dialog.UISleep.TestAndShow
        ui_sleep_dialog.UISleep.TestAndShow = function(self, force)
            if rtz_mcm.get_config("enabled") and rtz_mcm.get_config("enable_realtime_rest") then
                local src = (self.ph_sleepbag_id and self.ph_sleepbag_id > 0) and "sleepbag" or "bed"
                start_resting(src, force)
                return
            end
            return org_test_and_show(self, force)
        end
    end

    hooks_installed = true
    printf_rtz("Sleep dialog hooks successfully installed.")
end

function init()
    install_sleep_hooks()
    RegisterScriptCallback("actor_on_net_destroy", abort_resting)
    RegisterScriptCallback("on_before_level_changing", restore_saved_volumes)
    if ui_main_menu and ui_main_menu.main_menu and ui_main_menu.main_menu.OnButton_quit_clicked and not ui_main_menu.main_menu.__rtz_quit_hooked then
        local org_quit = ui_main_menu.main_menu.OnButton_quit_clicked
        ui_main_menu.main_menu.OnButton_quit_clicked = function(self)
            restore_saved_volumes()
            return org_quit(self)
        end
        ui_main_menu.main_menu.__rtz_quit_hooked = true
    end
end

function update()
    if is_resting then
        update_active_rest()
    else
        update_campfire_rest()
    end
end
