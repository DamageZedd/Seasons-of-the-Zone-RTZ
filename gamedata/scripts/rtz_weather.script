-- =======================================================================================
-- Real Time Zone (RTZ) - Live Real-World Weather Integration Module
-- Addon for Seasons of the Zone by Denis_Zedd
-- =======================================================================================

local last_weather_check = 0
local hooked = false
local cached_rtz_ini = nil
local cached_sotz_ini = nil

local function printf_rtz(fmt, ...)
    printf("[RTZ Weather] " .. fmt, ...)
end

local function get_inis()
    if not cached_rtz_ini then
        cached_rtz_ini = ini_file("rtz_weather.ltx")
    end
    if not cached_sotz_ini then
        cached_sotz_ini = ini_file("season_weather.ltx")
    end
    return cached_rtz_ini, cached_sotz_ini
end

--- Normalizes a weather cycle name against the active WeatherManager's presets
local function normalize_cycle(mgr, cycle)
    if not cycle or not mgr or not mgr.presets then return nil end
    if cycle == "snow" and not mgr.presets["snow"] then
        cycle = mgr.presets["rain"] and "rain" or "cloudy"
    end
    if mgr.presets[cycle] then
        return cycle
    end
    return nil
end

--- Parses a forecast line `"high, low, cycle"` from `[forecast]` in `season_weather.ltx`
local function parse_forecast_entry(sotz_ini, date_key)
    if not sotz_ini or not sotz_ini:section_exist("forecast") then return nil end
    if not sotz_ini:line_exist("forecast", date_key) then return nil end
    local raw = tostring(sotz_ini:r_string_ex("forecast", date_key) or "")
    local h_str, l_str, cyc = raw:match("^%s*([%-%.%d]+)%s*,%s*([%-%.%d]+)%s*,%s*([%w_]+)")
    if cyc and cyc ~= "" then
        return {
            high = tonumber(h_str) or 15,
            low = tonumber(l_str) or 5,
            cycle = cyc,
        }
    end
    return nil
end

--- Reads today's and tomorrow's Open-Meteo data from `season_weather.ltx`
local function get_sotz_days(sotz_ini)
    if not sotz_ini then return nil, nil end

    local now_ts = os.time()
    local real_today = os.date("*t", now_ts)
    local real_next  = os.date("*t", now_ts + 86400)

    local today_data, next_data = nil, nil
    if real_today then
        local today_key = string.format("%04d-%02d-%02d", real_today.year, real_today.month, real_today.day)
        today_data = parse_forecast_entry(sotz_ini, today_key)
    end
    if real_next then
        local next_key = string.format("%04d-%02d-%02d", real_next.year, real_next.month, real_next.day)
        next_data = parse_forecast_entry(sotz_ini, next_key)
    end

    if not today_data and sotz_ini:section_exist("weather") then
        local cyc = sotz_ini:r_string_ex("weather", "cycle")
        if cyc and cyc ~= "" then
            today_data = {
                high = sotz_ini:r_float_ex("weather", "high") or 15,
                low  = sotz_ini:r_float_ex("weather", "low") or 5,
                cycle = cyc:match("^[%w_]+"),
            }
        end
    end

    if not next_data and sotz_ini:section_exist("weather_next") then
        local cyc = sotz_ini:r_string_ex("weather_next", "cycle")
        if cyc and cyc ~= "" then
            next_data = {
                high = sotz_ini:r_float_ex("weather_next", "high") or (today_data and today_data.high or 15),
                low  = sotz_ini:r_float_ex("weather_next", "low") or (today_data and today_data.low or 5),
                cycle = cyc:match("^[%w_]+"),
            }
        end
    end

    return today_data, next_data or today_data
end

local BRIDGE_CYCLE = {
    ["clear>cloudy"]  = "partly",
    ["clear>rain"]    = "cloudy",
    ["clear>storm"]   = "cloudy",
    ["clear>snow"]    = "cloudy",
    ["partly>rain"]   = "cloudy",
    ["partly>storm"]  = "cloudy",
    ["cloudy>clear"]  = "partly",
    ["rain>clear"]    = "partly",
    ["rain>partly"]   = "cloudy",
    ["storm>clear"]   = "cloudy",
    ["storm>partly"]  = "rain",
    ["storm>cloudy"]  = "rain",
}

--- Retrieves the live weather cycle for `target_hour` (0..23):
--- 1) Uses live 24-hour Open-Meteo `[hourly]` data in `rtz_weather.ltx` (installed by `setup_rtz.bat`)
--- 2) Falls back to diurnal modeling from `season_weather.ltx` if `setup_rtz.bat` hasn't been run yet
function get_real_cycle(target_hour)
    local cur_h = (target_hour or level.get_time_hours()) % 24
    local rtz_ini, sotz_ini = get_inis()

    -- 1. Check dedicated rtz_weather.ltx generated by _tools/fetch_rtz_hourly.py
    if rtz_ini and rtz_ini:section_exist("hourly") then
        local cycle = rtz_ini:r_string_ex("hourly", tostring(cur_h))
                   or rtz_ini:r_string_ex("hourly", "h" .. tostring(cur_h))
        if cycle and cycle ~= "" then
            return cycle:match("^[%w_]+")
        end
    end

    -- 2. Fallback: Check Seasons of the Zone's season_weather.ltx
    if sotz_ini then
        if sotz_ini:section_exist("hourly") then
            local cycle = sotz_ini:r_string_ex("hourly", tostring(cur_h))
                       or sotz_ini:r_string_ex("hourly", "h" .. tostring(cur_h))
            if cycle and cycle ~= "" then
                return cycle:match("^[%w_]+")
            end
        end

        local today, tomorrow = get_sotz_days(sotz_ini)
        if today and today.cycle then
            local main_c = today.cycle
            local next_c = (tomorrow and tomorrow.cycle) or main_c
            local spread = (today.high or 15) - (today.low or 5)

            if cur_h >= 5 and cur_h <= 7 then
                if spread >= 9 and (today.low or 10) <= 9 and (main_c == "clear" or main_c == "partly") then
                    return (cur_h <= 6) and "foggy" or "partly"
                elseif main_c == "storm" then
                    return "rain"
                end
                return main_c
            elseif cur_h >= 8 and cur_h <= 17 then
                if main_c == "storm" and (cur_h < 13 or cur_h > 17) then
                    return "rain"
                end
                return main_c
            elseif cur_h >= 18 and cur_h <= 20 then
                return BRIDGE_CYCLE[main_c .. ">" .. next_c] or main_c
            elseif cur_h >= 21 then
                local bridge = BRIDGE_CYCLE[main_c .. ">" .. next_c]
                return (cur_h >= 23) and next_c or (bridge or next_c)
            end
            return main_c
        end
    end

    return nil
end

--- Rebuilds WeatherManager's `day_plan` so Seasons of the Zone's PDA Forecast tab reflects RTZ's schedule
local function sync_manager_day_plan(mgr)
    if not mgr or not mgr.abs_schedule_minute then return end
    pcall(function()
        local now_min = mgr:abs_schedule_minute()
        local cur_h = level.get_time_hours()
        local cur_m = level.get_time_minutes()
        local mins_to_next_hour = 60 - cur_m
        local plan = {}
        for offset = 1, 24 do
            local h = (cur_h + offset) % 24
            local seg_min = now_min + mins_to_next_hour + (offset - 1) * 60
            local cyc = normalize_cycle(mgr, get_real_cycle(h)) or mgr.cycle or "clear"
            plan[#plan + 1] = { minute = seg_min, cycle = cyc }
        end
        mgr.day_plan = plan
        mgr.day_plan_index = 1
    end)
end

--- Applies live weather transitions (`now = true` on initial load, `now = false` for smooth hourly transitions)
function update_weather(now)
    if not rtz_mcm.get_config("enabled") or not rtz_mcm.get_config("enable_real_weather") then
        return
    end

    -- Skip during indoor levels, active blowout, or scripted weather FX
    if level.is_wfx_playing and level.is_wfx_playing() then return end
    if surge_manager and surge_manager.is_started and surge_manager.is_started() then return end
    if psi_storm_manager and psi_storm_manager.is_started and psi_storm_manager.is_started() then return end

    local mgr = level_weathers and level_weathers.get_weather_manager and level_weathers.get_weather_manager()
    if not mgr or not mgr.presets or mgr.weatherType ~= "atmosfear" then return end
    if mgr.pre_blowout_period or mgr.weather_fx then return end

    local real_cycle = normalize_cycle(mgr, get_real_cycle())
    if not real_cycle then return end

    sync_manager_day_plan(mgr)

    -- Apply on initial load (`now == true`) or when the hourly real weather cycle changes
    if now or mgr.cycle ~= real_cycle then
        local changed = (mgr.cycle ~= real_cycle)
        printf_rtz("Applying real-world weather cycle: %s -> %s (now=%s)", tostring(mgr.cycle), real_cycle, tostring(now))
        mgr.cycle = real_cycle
        if mgr.presets[real_cycle] and random_key_table then
            mgr.preset = random_key_table(mgr.presets[real_cycle])
        end
        mgr:select_weather(now and true or false)

        if changed and not now and actor_menu and actor_menu.set_msg then
            local trans_str = game.translate_string("st_rtz_w_" .. real_cycle)
            actor_menu.set_msg(1, string.format(game.translate_string("st_rtz_weather_sync"), trans_str), 4)
        end
    end
end

--- Hooks level_weathers WeatherManager (both Atmospherics and W.P.W.M.) to guide cycle progression
local function install_weather_hooks()
    if hooked then return end
    if not level_weathers or not level_weathers.WeatherManager then return end

    -- 1. Hook get_next_weather_cycle
    if level_weathers.WeatherManager.get_next_weather_cycle then
        local org_get_next = level_weathers.WeatherManager.get_next_weather_cycle
        level_weathers.WeatherManager.get_next_weather_cycle = function(self, curr_weather, consecutive_repeats, hist)
            if rtz_mcm.get_config("enabled") and rtz_mcm.get_config("enable_real_weather") then
                local real = normalize_cycle(self, get_real_cycle())
                if real then
                    return real
                end
            end
            return org_get_next(self, curr_weather, consecutive_repeats, hist)
        end
    end

    -- 2. Hook W.P.W.M.'s check_day_plan so pre-rolled random segments don't overwrite real-world weather
    if level_weathers.WeatherManager.check_day_plan then
        local org_check_day_plan = level_weathers.WeatherManager.check_day_plan
        level_weathers.WeatherManager.check_day_plan = function(self)
            if rtz_mcm.get_config("enabled") and rtz_mcm.get_config("enable_real_weather") then
                if self.pre_blowout_period or self.weather_fx then
                    self.blowout_override = true
                    if not level.is_wfx_playing() then
                        self:select_weather(false)
                    end
                    return
                end
                local restored = false
                if self.blowout_override then
                    self.blowout_override = false
                    restored = true
                end
                local real = normalize_cycle(self, get_real_cycle())
                if real and (self.cycle ~= real or restored or self.forced_weather_change_on_time_change) then
                    self.cycle = real
                    if self.presets[real] and random_key_table then
                        self.preset = random_key_table(self.presets[real])
                    end
                    sync_manager_day_plan(self)
                    self:select_weather(false)
                end
                return
            end
            return org_check_day_plan(self)
        end
    end

    hooked = true
    printf_rtz("WeatherManager hooks successfully installed.")
end

function init()
    install_weather_hooks()
    update_weather(true)
end

function update()
    local tg = time_global()
    local interval = (rtz_mcm.get_config("weather_sync_interval") or 5) * 60000
    if tg > last_weather_check + interval then
        last_weather_check = tg
        update_weather(false)
    end
end
