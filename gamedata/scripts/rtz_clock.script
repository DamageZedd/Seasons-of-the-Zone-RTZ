-- =======================================================================================
-- Real Time Zone (RTZ) - Clock, Vitals Guard & Vanilla Pacing Module
-- Addon for Seasons of the Zone by Denis_Zedd
-- =======================================================================================

local VANILLA_TIME_FACTOR = 6.0

local last_drift_check = 0
local DRIFT_CHECK_MS = 20000 -- Check drift every 20s

local last_vitals_tick = 0
local VITALS_TICK_MS = 1000 -- Compensate C++ hunger every 1s

local last_booster_tick = 0
local BOOSTER_TICK_MS = 100 -- Compensate C++ medkit/booster healing & passive conditions every 100ms

local is_synced = false
local alife_hooks_installed = false
local arszi_psy_hooked = false
is_in_sleep_callback = false

local base_drink_chk = nil
local base_sleep_chk = nil
local cached_satiety_v = nil
local cached_psy_health_v = nil
local cached_alcohol_v = nil
local cached_wound_incarnation_v = nil

-- Active consumable boosters tracked in real seconds (matches C++ SBooster categories)
local active_boosters = {}

-- Monotonic real-time elapsed clock for Demonized's DAO (drx_da_main) & PBA (perk_based_artefacts)
local rtz_elapsed_anchor = nil
local rtz_elapsed_start_tg = nil
local rtz_elapsed_saved = nil
local orig_drx_get_time_elapsed = nil
local orig_pba_get_time_elapsed = nil

local function printf_rtz(fmt, ...)
    printf("[RTZ Clock] " .. fmt, ...)
end

--- Helper to read a local upvalue by name from a function
local function get_upvalue_by_name(fn, target_name)
    if type(fn) ~= "function" or not debug or not debug.getupvalue then
        return nil, nil
    end
    local i = 1
    while true do
        local name, val = debug.getupvalue(fn, i)
        if not name then break end
        if name == target_name then
            return val, i
        end
        i = i + 1
    end
    return nil, nil
end

--- Helper to set a local upvalue by name on a function
local function set_upvalue_by_name(fn, target_name, new_val)
    local _, idx = get_upvalue_by_name(fn, target_name)
    if idx and debug and debug.setupvalue then
        debug.setupvalue(fn, idx, new_val)
        return true
    end
    return false
end

--- Safely retrieves in-game (hours, minutes, seconds) using level and CTime:get()
local function get_game_hms()
    local h = (level and level.get_time_hours and level.get_time_hours()) or 0
    local m = (level and level.get_time_minutes and level.get_time_minutes()) or 0
    local s = 0
    if game and game.get_game_time then
        local gt = game.get_game_time()
        if gt and gt.get then
            local Y, M, D, gh, gm, gs, ms = 0, 0, 0, 0, 0, 0, 0
            Y, M, D, gh, gm, gs, ms = gt:get(Y, M, D, gh, gm, gs, ms)
            s = gs or 0
        end
    end
    return h, m, s
end

--- Returns the current ratio (cur_tf / 6.0) when vanilla scale preservation is active, or 1.0 otherwise
function get_vanilla_scale_ratio()
    if not rtz_mcm.get_config("enabled") or not rtz_mcm.get_config("vanilla_vitals_alife_scale") then
        return 1.0
    end
    local cur_tf = (level and level.get_time_factor and level.get_time_factor())
        or rtz_mcm.get_config("time_factor_val")
        or 1.0
    return math.max(0.05, cur_tf / VANILLA_TIME_FACTOR)
end

--- Like get_vanilla_scale_ratio, but uses the time factor RTZ is configured to run at, not the current one.
--- Emission managers roll the next delta while the emission's own factor is still active, which would
--- otherwise stretch the delta far too long.
function get_target_scale_ratio()
    if not rtz_mcm.get_config("enabled") or not rtz_mcm.get_config("vanilla_vitals_alife_scale") then
        return 1.0
    end
    local tf
    if rtz_mcm.get_config("lock_time_factor") then
        tf = rtz_mcm.get_config("time_factor_val")
    end
    tf = tf or (level and level.get_time_factor and level.get_time_factor()) or 1.0
    return math.max(0.05, tf / VANILLA_TIME_FACTOR)
end

--- Snapshots exact actor vitals and timer offsets prior to ANY level.change_game_time call
function snapshot_vitals()
    local snap = {}
    pcall(function()
        local now_gt = game and game.get_game_time and game.get_game_time() or nil
        if db.actor then
            snap.satiety = db.actor.satiety
            snap.health = db.actor.health
            snap.power = db.actor.power
        end
        if actor_status_sleep then
            if actor_status_sleep.get_last_sleep then
                snap.sleep = actor_status_sleep.get_last_sleep()
            end
            if now_gt and actor_status_sleep.actor_on_update then
                local last_chk = get_upvalue_by_name(actor_status_sleep.actor_on_update, "last_sleep_chk")
                if last_chk and now_gt.diffSec then
                    snap.sleep_elapsed = math.max(0, math.floor(now_gt:diffSec(last_chk)))
                end
            end
        end
        if actor_status_thirst then
            if actor_status_thirst.get_last_drink then
                snap.drink = actor_status_thirst.get_last_drink()
            end
            if now_gt and actor_status_thirst.actor_on_update then
                local last_chk = get_upvalue_by_name(actor_status_thirst.actor_on_update, "last_drink_chk")
                if last_chk and now_gt.diffSec then
                    snap.drink_elapsed = math.max(0, math.floor(now_gt:diffSec(last_chk)))
                end
            end
        end
        if surge_manager and surge_manager.get_surge_manager then
            local sm = surge_manager.get_surge_manager()
            if sm and sm.last_surge_time and now_gt then
                snap.surge_elapsed = math.max(0, math.floor(now_gt:diffSec(sm.last_surge_time)))
            end
        end
        if psi_storm_manager and psi_storm_manager.get_psi_storm_manager then
            local pm = psi_storm_manager.get_psi_storm_manager()
            if pm and pm.last_psi_storm_time and now_gt then
                snap.psi_elapsed = math.max(0, math.floor(now_gt:diffSec(pm.last_psi_storm_time)))
            end
        end
    end)
    return snap
end

--- Helper to create a CTime offset backwards by `elapsed_sec` from current `game.get_game_time()`
local function make_offset_ctime(now_gt, elapsed_sec)
    if not now_gt or not elapsed_sec or elapsed_sec <= 0 then
        return now_gt
    end
    local ok, res = pcall(function()
        local Y, M, D, h, m, s, ms = 0, 0, 0, 0, 0, 0, 0
        Y, M, D, h, m, s, ms = now_gt:get(Y, M, D, h, m, s, ms)
        local t = game.CTime()
        t:set(Y, M, D, h, m, s, ms)
        local sub = game.CTime()
        local eh = math.floor(elapsed_sec / 3600)
        local em = math.floor((elapsed_sec % 3600) / 60)
        local es = elapsed_sec % 60
        sub:setHMS(eh, em, es)
        t:sub(sub)
        return t
    end)
    return (ok and res) or now_gt
end

--- Restores exact pre-jump player vitals and shifts timestamps so clock sync leaves hunger/thirst/sleep 100% untouched
function restore_vitals_exact(snap)
    if not snap then return end
    pcall(function()
        local now_gt = game and game.get_game_time and game.get_game_time() or nil

        -- 1. Preserve Surge & Psi-Storm elapsed progress across clock sync (only when not currently active)
        -- Also align inited_time to now_gt and clear time_forwarded so CSurgeManager:update()/CPsiStormManager:update()
        -- never falsely trigger skip_surge()/skip_psi_storm() on first_update or postpone imminent radio-announced emissions
        if now_gt and surge_manager and surge_manager.get_surge_manager then
            local sm = surge_manager.get_surge_manager()
            if sm and not sm.started then
                if snap.surge_elapsed then
                    sm.last_surge_time = make_offset_ctime(now_gt, snap.surge_elapsed)
                end
                sm.inited_time = now_gt
                sm.time_forwarded = false
            end
        end
        if now_gt and psi_storm_manager and psi_storm_manager.get_psi_storm_manager then
            local pm = psi_storm_manager.get_psi_storm_manager()
            if pm and not pm.started then
                if snap.psi_elapsed then
                    pm.last_psi_storm_time = make_offset_ctime(now_gt, snap.psi_elapsed)
                end
                pm.inited_time = now_gt
                pm.time_forwarded = false
            end
        end

        if not rtz_mcm.get_config("safeguard_vitals") then
            return
        end

        -- 2. Restore exact Sleep Deprivation & shift chk_sleep timestamp
        if actor_status_sleep and snap.sleep ~= nil then
            local new_sleep_chk = make_offset_ctime(now_gt, snap.sleep_elapsed or 0)
            local chk_tbl = (utils_data and utils_data.CTime_to_table and new_sleep_chk)
                and utils_data.CTime_to_table(new_sleep_chk) or nil
            if actor_status_sleep.load_state then
                actor_status_sleep.load_state({
                    sleep = {
                        last_sleep = snap.sleep,
                        chk_sleep = chk_tbl,
                    }
                })
            end
            if alife_storage_manager and alife_storage_manager.get_state then
                local st = alife_storage_manager.get_state()
                if st and st.sleep then
                    st.sleep.last_sleep = snap.sleep
                    st.sleep.chk_sleep = chk_tbl
                end
            end
            if actor_status_sleep.test_blur then
                actor_status_sleep.test_blur()
            end
        end

        -- 3. Restore exact Thirst Deprivation & shift chk_drink timestamp
        if actor_status_thirst and snap.drink ~= nil then
            local new_drink_chk = make_offset_ctime(now_gt, snap.drink_elapsed or 0)
            local chk_tbl = (utils_data and utils_data.CTime_to_table and new_drink_chk)
                and utils_data.CTime_to_table(new_drink_chk) or nil
            if actor_status_thirst.load_state then
                actor_status_thirst.load_state({
                    drink = {
                        last_drink = snap.drink,
                        chk_drink = chk_tbl,
                    }
                })
            end
            if alife_storage_manager and alife_storage_manager.get_state then
                local st = alife_storage_manager.get_state()
                if st and st.drink then
                    st.drink.last_drink = snap.drink
                    st.drink.chk_drink = chk_tbl
                end
            end
            if actor_status_thirst.test_blur then
                actor_status_thirst.test_blur()
            end
        end

        -- 4. Restore exact C++ engine actor conditions (satiety/hunger, health, power)
        -- Note: db.actor.bleeding setter in xray-monolith is ChangeBleeding (shrinks wounds), so never assign it
        if db.actor then
            if snap.satiety ~= nil and db.actor.satiety ~= nil then
                db.actor.satiety = snap.satiety
            end
            if snap.health ~= nil and db.actor.health ~= nil then
                db.actor.health = snap.health
            end
            if snap.power ~= nil and db.actor.power ~= nil then
                db.actor.power = snap.power
            end
        end
    end)
end

--- Wrapper around level.change_game_time that strictly guards hunger, thirst, sleep, and emission timers
function change_game_time_guarded(days, hours, mins)
    if not level or not level.change_game_time then return end
    local snap = snapshot_vitals()
    level.change_game_time(days or 0, hours or 0, mins or 0)
    restore_vitals_exact(snap)
end

-- =======================================================================================
-- Vanilla Time-Scale Preservation for Hunger, Thirst, Sleep & A-Life
-- + Hunger/Thirst Mode (Vanilla 6x / Real-Time 1:1 / Disabled)
-- + 1:1 Medkit/Booster Healing & Anomaly Camera Shake Fixes
-- =======================================================================================

--- Tracks consumable items with `boost_time > 0` so RTZ can compensate C++ healing at 1:1 time_factor
local function on_actor_item_use(obj, sec)
    pcall(function()
        sec = sec or (obj and obj.section and obj:section())
        if not sec or not ini_sys then return end

        if sec == "drug_anabiotic" then
            active_boosters = {}
            return
        end

        local bt = ini_sys:r_float_ex(sec, "boost_time") or 0
        if not bt or bt <= 0 then return end

        local hp_rate  = ini_sys:r_float_ex(sec, "boost_health_restore") or 0
        local pwr_rate = ini_sys:r_float_ex(sec, "boost_power_restore") or 0
        local rad_rate = ini_sys:r_float_ex(sec, "boost_radiation_restore") or 0
        local bld_rate = ini_sys:r_float_ex(sec, "boost_bleeding_restore") or 0

        if hp_rate ~= 0 then
            active_boosters.hp = { rate = hp_rate, remaining = bt }
        end
        if pwr_rate ~= 0 then
            active_boosters.pwr = { rate = pwr_rate, remaining = bt }
        end
        if rad_rate ~= 0 then
            active_boosters.rad = { rate = rad_rate, remaining = bt }
        end
        if bld_rate ~= 0 then
            active_boosters.bld = { rate = bld_rate, remaining = bt }
        end
    end)
end

--- Compensates C++ medkit/drug boosters and passive conditions (psy, alcohol, wound healing) every 100ms
local function update_boosters_and_effects(tg)
    if last_booster_tick == 0 then
        last_booster_tick = tg
        return
    end
    if tg < last_booster_tick + BOOSTER_TICK_MS then
        return
    end

    local dt_real = math.min(1.0, (tg - last_booster_tick) / 1000.0)
    last_booster_tick = tg

    if not db.actor or not db.actor:alive() then
        active_boosters = {}
        return
    end

    -- Enforce "No Eat / Drink" mode immediately if vitals_mode == 2
    if rtz_mcm.get_config("enabled") and (tonumber(rtz_mcm.get_config("vitals_mode")) or 0) == 2 then
        pcall(function()
            if db.actor.satiety and db.actor.satiety < 0.999 then
                db.actor.satiety = 1.0
            end
        end)
    end

    pcall(function()
        local cur_tf = (level and level.get_time_factor and level.get_time_factor()) or 1.0
        local missing_tf = math.max(0.0, VANILLA_TIME_FACTOR - cur_tf)
        local do_comp = rtz_mcm.get_config("enabled")
            and rtz_mcm.get_config("fix_boosters_and_effects")
            and (missing_tf > 0.05)
            and not (rtz_rest and rtz_rest.is_resting)

        -- 1. Tick active consumable boosters (medkits, bandages, stimpacks, antirad, drugs)
        for k, b in pairs(active_boosters) do
            local step_dt = math.min(b.remaining, dt_real)
            b.remaining = b.remaining - step_dt

            if do_comp and step_dt > 0 then
                if k == "hp" and db.actor.change_health then
                    db.actor:change_health(b.rate * missing_tf * step_dt)
                elseif k == "pwr" and db.actor.change_power then
                    db.actor:change_power(b.rate * missing_tf * step_dt)
                elseif k == "rad" and db.actor.change_radiation then
                    if (b.rate > 0 and (db.actor.radiation or 0) > 0) or b.rate < 0 then
                        db.actor:change_radiation(-b.rate * missing_tf * step_dt)
                    end
                elseif k == "bld" and b.rate > 0 and (db.actor.bleeding or 0) > 0 then
                    -- The `bleeding` setter is ChangeBleeding: a positive value shrinks wounds
                    db.actor.bleeding = b.rate * missing_tf * step_dt
                end
            end

            if b.remaining <= 0.0001 then
                active_boosters[k] = nil
            end
        end

        -- 2. Compensate passive C++ actor_condition recovery (psy_health_v, alcohol_v, wound_incarnation_v)
        if do_comp then
            if not cached_psy_health_v then
                cached_psy_health_v = (ini_sys and ini_sys:r_float_ex("actor_condition", "psy_health_v")) or 0.001
                cached_alcohol_v = (ini_sys and ini_sys:r_float_ex("actor_condition", "alcohol_v")) or -0.0003
                cached_wound_incarnation_v = (ini_sys and ini_sys:r_float_ex("actor_condition", "wound_incarnation_v")) or 0.0003
            end
            if (db.actor.psy_health or 1.0) < 1.0 and db.actor.change_psy_health then
                db.actor:change_psy_health(cached_psy_health_v * missing_tf * dt_real)
            end
            if (db.actor.alcohol or 0) > 0 and db.actor.ChangeAlcohol then
                db.actor:ChangeAlcohol(cached_alcohol_v * missing_tf * dt_real)
            end
            if (db.actor.bleeding or 0) > 0 then
                db.actor.bleeding = cached_wound_incarnation_v * missing_tf * dt_real
            end
        end
    end)
end

--- Monotonic real-time `get_time_elapsed` replacement for DAO (`drx_da_main`) and PBA (`perk_based_artefacts`)
local function get_rtz_monotonic_elapsed()
    if not rtz_elapsed_anchor or not rtz_elapsed_start_tg then
        local raw = 0
        pcall(function()
            raw = math.floor(game.get_game_time():diffSec(level.get_start_time()) / VANILLA_TIME_FACTOR * 10) * 0.1
        end)
        local min_surge = (drx_da_main and tonumber(drx_da_main.last_surge_time)) or 0
        -- Anchor to the larger of the raw clock and the saved value so loads never rewind PBA/DAO timers
        rtz_elapsed_anchor = math.max(raw, min_surge + 1.0, rtz_elapsed_saved or 0)
        rtz_elapsed_start_tg = time_global()
    end
    local dt_sec = math.max(0, time_global() - rtz_elapsed_start_tg) * 0.001
    return math.floor((rtz_elapsed_anchor + dt_sec) * 10) * 0.1
end

--- Returns the monotonic elapsed value to persist in the save file
function get_elapsed_for_save()
    if not rtz_elapsed_anchor then return rtz_elapsed_saved end
    return get_rtz_monotonic_elapsed()
end

--- Restores the saved elapsed value and forces re-anchoring on the next read
function set_elapsed_from_save(val)
    rtz_elapsed_saved = tonumber(val)
    rtz_elapsed_anchor = nil
    rtz_elapsed_start_tg = nil
end

local function rtz_drx_get_time_elapsed()
    if not rtz_mcm.get_config("enabled") or not rtz_mcm.get_config("fix_boosters_and_effects") then
        if orig_drx_get_time_elapsed then
            return orig_drx_get_time_elapsed()
        end
    end
    return get_rtz_monotonic_elapsed()
end

local function rtz_pba_get_time_elapsed()
    if not rtz_mcm.get_config("enabled") or not rtz_mcm.get_config("fix_boosters_and_effects") then
        if orig_pba_get_time_elapsed then
            return orig_pba_get_time_elapsed()
        end
    end
    return get_rtz_monotonic_elapsed()
end

--- Patches Demonized's DAO (`drx_da_main`), PBA (`perk_based_artefacts`), and `arszi_psy` so anomaly camera
--- shakes (`earthquake_40.anm`), timed effects, and psy recovery run at 1:1 real-time speed
local function patch_external_time_elapsed_mods()
    pcall(function()
        -- 1. Patch Dynamic Anomalies Overhaul / Arrival (drx_da_main)
        if drx_da_main then
            if drx_da_main.actor_on_update then
                local cur_fn = get_upvalue_by_name(drx_da_main.actor_on_update, "get_time_elapsed")
                if cur_fn and cur_fn ~= rtz_drx_get_time_elapsed then
                    orig_drx_get_time_elapsed = cur_fn
                    set_upvalue_by_name(drx_da_main.actor_on_update, "get_time_elapsed", rtz_drx_get_time_elapsed)
                end
            end
            if drx_da_main.actor_on_interaction then
                set_upvalue_by_name(drx_da_main.actor_on_interaction, "get_time_elapsed", rtz_drx_get_time_elapsed)
            end
            -- Clamp any stale future timed_effects (e.g. stuck camera shake from before fix)
            if type(drx_da_main.timed_effects) == "table" then
                local now_el = get_rtz_monotonic_elapsed()
                for _, props in pairs(drx_da_main.timed_effects) do
                    if type(props) == "table" and type(props.timer) == "number" and props.timer > now_el + 120 then
                        props.timer = now_el + 1.0
                    end
                end
            end
        end

        -- 2. Patch Perk-Based Artefacts (perk_based_artefacts)
        -- Swap its get_time_elapsed upvalue with the monotonic real-time clock (same as DAO) so time_elapsed
        -- advances strictly 1.0s per real second and never jumps when time_factor changes (protecting Lucifer
        -- degradation rate and timed cooldowns across emissions and catch-up holds).
        if perk_based_artefacts and perk_based_artefacts.actor_on_update then
            local cur_fn = get_upvalue_by_name(perk_based_artefacts.actor_on_update, "get_time_elapsed")
            if cur_fn and cur_fn ~= rtz_pba_get_time_elapsed then
                orig_pba_get_time_elapsed = cur_fn
                set_upvalue_by_name(perk_based_artefacts.actor_on_update, "get_time_elapsed", rtz_pba_get_time_elapsed)
            end
        end

        -- 3. Hook arszi_psy.get_psy_health_regeneration so psy-health recovers at vanilla real-time speed
        if not arszi_psy_hooked and arszi_psy and arszi_psy.get_psy_health_regeneration then
            local org_get_psy_regen = arszi_psy.get_psy_health_regeneration
            arszi_psy.get_psy_health_regeneration = function(...)
                local val = org_get_psy_regen(...)
                if is_in_sleep_callback then
                    return val
                end
                if type(val) == "number" and rtz_mcm.get_config("enabled") and rtz_mcm.get_config("fix_boosters_and_effects") then
                    local cur_tf = (level and level.get_time_factor and level.get_time_factor()) or 1.0
                    local scale = math.max(1.0, VANILLA_TIME_FACTOR / math.max(0.5, cur_tf))
                    return val * scale
                end
                return val
            end
            arszi_psy_hooked = true
            printf_rtz("Hooked arszi_psy.get_psy_health_regeneration for 1:1 real-time psy recovery.")
        end
    end)
end

--- Syncs Thirst and Sleep check intervals based on `vitals_mode` and `vanilla_vitals_alife_scale`
local function sync_thirst_and_sleep_intervals()
    pcall(function()
        local ratio = get_vanilla_scale_ratio()
        local enabled = rtz_mcm.get_config("enabled")
        local vitals_mode = enabled and (tonumber(rtz_mcm.get_config("vitals_mode")) or 0) or 0

        if actor_status_thirst and actor_status_thirst.actor_on_update then
            if not base_drink_chk then
                base_drink_chk = get_upvalue_by_name(actor_status_thirst.actor_on_update, "drink_chk") or 300
            end
            local target_drink_chk = base_drink_chk
            if vitals_mode == 2 then
                -- Disabled (No Eat / Drink): prevent thirst ticks and keep last_drink at 0
                target_drink_chk = 300000
                if actor_status_thirst.get_last_drink and (actor_status_thirst.get_last_drink() or 0) > 0 then
                    local now_gt = game and game.get_game_time and game.get_game_time() or nil
                    local chk_tbl = (utils_data and utils_data.CTime_to_table and now_gt)
                        and utils_data.CTime_to_table(now_gt) or nil
                    if actor_status_thirst.load_state then
                        actor_status_thirst.load_state({
                            drink = {
                                last_drink = 0,
                                chk_drink = chk_tbl,
                            }
                        })
                    end
                    if alife_storage_manager and alife_storage_manager.get_state then
                        local st = alife_storage_manager.get_state()
                        if st and st.drink then
                            st.drink.last_drink = 0
                            st.drink.chk_drink = chk_tbl
                        end
                    end
                    if actor_status_thirst.test_blur then
                        actor_status_thirst.test_blur()
                    end
                end
            elseif vitals_mode == 1 then
                -- 1:1 Real-Time Speed: use unscaled 300 in-game seconds (5 real minutes per tick)
                target_drink_chk = base_drink_chk
            else
                -- Vanilla 6x Speed: scale by ratio (50 real seconds per tick)
                target_drink_chk = math.max(10, math.floor(base_drink_chk * ratio + 0.5))
            end
            set_upvalue_by_name(actor_status_thirst.actor_on_update, "drink_chk", target_drink_chk)
        end

        if actor_status_sleep and actor_status_sleep.actor_on_update then
            if not base_sleep_chk then
                base_sleep_chk = get_upvalue_by_name(actor_status_sleep.actor_on_update, "sleep_chk") or 300
            end
            local target_sleep_chk = math.max(10, math.floor(base_sleep_chk * ratio + 0.5))
            set_upvalue_by_name(actor_status_sleep.actor_on_update, "sleep_chk", target_sleep_chk)
        end

        -- Keep SurgeManager & PsiStormManager `inited_time` aligned and `time_forwarded = false` while idle
        if enabled and game and game.get_game_time then
            local now_gt = game.get_game_time()
            if surge_manager and surge_manager.get_surge_manager then
                local sm = surge_manager.get_surge_manager()
                if sm and not sm.started then
                    sm.inited_time = now_gt
                    sm.time_forwarded = false
                end
            end
            if psi_storm_manager and psi_storm_manager.get_psi_storm_manager then
                local pm = psi_storm_manager.get_psi_storm_manager()
                if pm and not pm.started then
                    pm.inited_time = now_gt
                    pm.time_forwarded = false
                end
            end
        end
    end)
end

--- Compensates C++ engine hunger drain (`satiety_v`) based on `vitals_mode` and `vanilla_vitals_alife_scale`
local function update_vanilla_hunger_drain(tg)
    if last_vitals_tick == 0 then
        last_vitals_tick = tg
        return
    end
    if tg < last_vitals_tick + VITALS_TICK_MS then
        return
    end

    local dt_real = math.min(5.0, (tg - last_vitals_tick) / 1000.0)
    last_vitals_tick = tg

    -- Sync Thirst & Sleep check upvalues and DAO/PBA/Psy hooks
    sync_thirst_and_sleep_intervals()
    patch_external_time_elapsed_mods()

    if not rtz_mcm.get_config("enabled") then
        return
    end
    if not db.actor or not db.actor:alive() then
        return
    end

    local vitals_mode = tonumber(rtz_mcm.get_config("vitals_mode")) or 0
    if vitals_mode == 2 then
        -- Disabled (No Eat / Drink): lock satiety at 100%
        pcall(function()
            if db.actor.satiety and db.actor.satiety < 0.999 then
                db.actor.satiety = 1.0
            end
        end)
        return
    elseif vitals_mode == 1 then
        -- 1:1 Real-Time Speed: let C++ engine drain satiety naturally at 1:1 time_factor
        return
    end

    -- vitals_mode == 0 (Vanilla 6x Speed)
    if not rtz_mcm.get_config("vanilla_vitals_alife_scale") then
        return
    end
    -- Do not drain extra hunger in God Mode or while inside RTZ Rest screen
    if get_console_cmd and get_console_cmd(1, "g_god") then
        return
    end
    if rtz_rest and rtz_rest.is_resting then
        return
    end

    pcall(function()
        local cur_tf = (level and level.get_time_factor and level.get_time_factor()) or 1.0
        local missing_tf = VANILLA_TIME_FACTOR - cur_tf
        if missing_tf <= 0.05 then
            return
        end

        if not cached_satiety_v then
            cached_satiety_v = (ini_sys and ini_sys:r_float_ex("actor_condition", "satiety_v")) or 0.00002
        end

        local sat_factor = 1.0
        if game_difficulties and game_difficulties.get_game_factor then
            local f = game_difficulties.get_game_factor("satiety")
            if type(f) == "number" then
                sat_factor = f
            elseif f == false then
                sat_factor = 0.0
            end
        end

        if sat_factor > 0 and db.actor.change_satiety then
            local delta_sat = -cached_satiety_v * sat_factor * missing_tf * dt_real
            db.actor:change_satiety(delta_sat)
        end
    end)
end

--- Scales A-Life squad stay/idle timers to match vanilla 6.0x real-time pacing
local function on_squad_update(squad)
    if not squad or not squad.idle_time then return end
    if not squad.__rtz_base_idle then
        squad.__rtz_base_idle = squad.idle_time
    end
    local ratio = get_vanilla_scale_ratio()
    squad.idle_time = math.max(15, math.floor(squad.__rtz_base_idle * ratio + 0.5))
end

--- Scales Smart Terrain respawn timers to match vanilla 6.0x real-time pacing
local function on_smart_try_respawn(smart, flags)
    if not smart then return end
    if smart.respawn_idle then
        if not smart.__rtz_base_respawn_idle then
            smart.__rtz_base_respawn_idle = smart.respawn_idle
        end
        local ratio = get_vanilla_scale_ratio()
        smart.respawn_idle = math.max(60, math.floor(smart.__rtz_base_respawn_idle * ratio + 0.5))
    end
end

--- Returns real-time (min_sec, max_sec) bounds for Emissions / Psi-Storms based on `emission_frequency_mode`
local function get_emission_interval_bounds(is_psi_storm)
    local mode = (rtz_mcm.get_config("enabled") and tonumber(rtz_mcm.get_config("emission_frequency_mode"))) or 0
    if mode == 1 then
        return 6 * 3600, 12 * 3600   -- 6-12 Real Hours
    elseif mode == 2 then
        return 12 * 3600, 24 * 3600  -- 12-24 Real Hours
    elseif mode == 3 then
        return 24 * 3600, 48 * 3600  -- 1-2 Real Days (24-48 Hours)
    elseif mode == 4 then
        return 48 * 3600, 96 * 3600  -- 2-4 Real Days (48-96 Hours)
    end

    -- mode == 0: Vanilla Anomaly setting scaled to real time (~2-4 Real Hours by default)
    local opt_key = is_psi_storm and "alife/event/psi_storm_frequency" or "alife/event/emission_frequency"
    local freq = (ui_options and ui_options.get and tonumber(ui_options.get(opt_key))) or 24
    local ratio = get_target_scale_ratio()
    local min_s = math.max(600, math.floor(math.floor(freq / 2) * 3600 * ratio + 0.5))
    local max_s = math.max(min_s + 600, math.floor(freq * 3600 * ratio + 0.5))
    return min_s, max_s
end

--- Rolls a real-time `_delta` for Surge or Psi-Storm and ensures at least 30 real minutes separation between the two
local function roll_emission_delta(is_psi_storm, mgr, other_mgr)
    if not mgr then return end
    local min_s, max_s = get_emission_interval_bounds(is_psi_storm)
    local delta = math.random(min_s, max_s)
    pcall(function()
        local g_time = game and game.get_game_time and game.get_game_time()
        local my_last = is_psi_storm and mgr.last_psi_storm_time or mgr.last_surge_time
        local other_last = other_mgr and (is_psi_storm and other_mgr.last_surge_time or other_mgr.last_psi_storm_time)
        if g_time and my_last and other_last and other_mgr._delta then
            local my_rem = delta - g_time:diffSec(my_last)
            local other_rem = other_mgr._delta - g_time:diffSec(other_last)
            if math.abs(my_rem - other_rem) < 1800 then
                delta = delta + 1800
            end
        end
    end)
    mgr._delta = delta
    mgr.__rtz_mode = (rtz_mcm.get_config("enabled") and tonumber(rtz_mcm.get_config("emission_frequency_mode"))) or 0
end

--- Scales or updates Surge & Psi-Storm `_delta` and sanitizes `inited_time` on session load or MCM option change
function scale_initial_emission_deltas()
    pcall(function()
        if not rtz_mcm.get_config("enabled") then return end
        local now_gt = game and game.get_game_time and game.get_game_time() or nil
        local sm = surge_manager and surge_manager.get_surge_manager and surge_manager.get_surge_manager()
        local pm = psi_storm_manager and psi_storm_manager.get_psi_storm_manager and psi_storm_manager.get_psi_storm_manager()

        if sm and not sm.started then
            if now_gt then
                sm.inited_time = now_gt
            end
            sm.time_forwarded = false
            local min_s, max_s = get_emission_interval_bounds(false)
            local elapsed = (now_gt and sm.last_surge_time and now_gt.diffSec) and now_gt:diffSec(sm.last_surge_time) or 0
            if elapsed < 0 or (sm._delta and elapsed >= sm._delta) then
                -- Sanitize stale/corrupted last_surge_time from pre-fix saves so radio mods do not false-alarm
                if now_gt then sm.last_surge_time = now_gt end
                roll_emission_delta(false, sm, pm)
            elseif not sm._delta or sm._delta < min_s or sm._delta > (max_s + 3600) then
                roll_emission_delta(false, sm, pm)
                if elapsed >= sm._delta and now_gt then
                    sm.last_surge_time = now_gt
                end
            end
        end

        if pm and not pm.started then
            if now_gt then
                pm.inited_time = now_gt
            end
            pm.time_forwarded = false
            local min_s, max_s = get_emission_interval_bounds(true)
            local elapsed = (now_gt and pm.last_psi_storm_time and now_gt.diffSec) and now_gt:diffSec(pm.last_psi_storm_time) or 0
            if elapsed < 0 or (pm._delta and elapsed >= pm._delta) then
                if now_gt then pm.last_psi_storm_time = now_gt end
                roll_emission_delta(true, pm, sm)
            elseif not pm._delta or pm._delta < min_s or pm._delta > (max_s + 3600) then
                roll_emission_delta(true, pm, sm)
                if elapsed >= pm._delta and now_gt then
                    pm.last_psi_storm_time = now_gt
                end
            end
        end
    end)
end

--- Installs A-Life hooks for squad movement idle timers, smart terrain respawn timers, emission roll scaling, and item booster tracking
local function install_alife_hooks()
    if alife_hooks_installed then return end
    alife_hooks_installed = true

    RegisterScriptCallback("squad_on_update", on_squad_update)
    RegisterScriptCallback("on_try_respawn", on_smart_try_respawn)
    RegisterScriptCallback("actor_on_item_use", on_actor_item_use)
    RegisterScriptCallback("mcm_option_change", scale_initial_emission_deltas)

    -- Wrap CSurgeManager.new_surge_time & CPsiStormManager.new_psi_storm_time to use RTZ real-time frequency bounds
    if surge_manager and surge_manager.CSurgeManager then
        if surge_manager.CSurgeManager.new_surge_time then
            local org_new_surge_time = surge_manager.CSurgeManager.new_surge_time
            surge_manager.CSurgeManager.new_surge_time = function(self, reset)
                org_new_surge_time(self, reset)
                if not rtz_mcm.get_config("enabled") then return end
                local pm = psi_storm_manager and psi_storm_manager.get_psi_storm_manager and psi_storm_manager.get_psi_storm_manager()
                roll_emission_delta(false, self, pm)
                if not self.started and game and game.get_game_time then
                    self.inited_time = game.get_game_time()
                end
            end
        end

        -- Wrap CSurgeManager.start so a naturally triggered emission at 1:1 time_factor aligns inited_time to now
        -- and is never falsely skipped by `diff_sec + 6 > self.surge_time` after radio/pre-surge warnings play
        if surge_manager.CSurgeManager.start then
            local org_surge_start = surge_manager.CSurgeManager.start
            surge_manager.CSurgeManager.start = function(self, manual)
                if rtz_mcm.get_config("enabled") and not self.started then
                    if game and game.get_game_time then
                        self.inited_time = game.get_game_time()
                    end
                    return org_surge_start(self, true)
                end
                return org_surge_start(self, manual)
            end
        end

        -- Wrap CSurgeManager.end_surge so lingering blowout weather FX (50 in-game mins) stops immediately
        -- instead of lasting 6x longer in real time at 1:1 time_factor, and re-syncs the clock to wall-clock time
        if surge_manager.CSurgeManager.end_surge then
            local org_end_surge = surge_manager.CSurgeManager.end_surge
            surge_manager.CSurgeManager.end_surge = function(self, manual)
                org_end_surge(self, manual)
                if rtz_mcm.get_config("enabled") then
                    pcall(function()
                        if level and level.is_wfx_playing and level.is_wfx_playing() then
                            level.stop_weather_fx()
                        end
                        if level_weathers and level_weathers.get_weather_manager then
                            local wm = level_weathers.get_weather_manager()
                            if wm and wm.forced_weather_change then
                                wm:forced_weather_change()
                            end
                        end
                    end)
                    enforce_time_factor()
                    sync_to_real_time(true)
                end
            end
        end
    end

    if psi_storm_manager and psi_storm_manager.CPsiStormManager then
        if psi_storm_manager.CPsiStormManager.new_psi_storm_time then
            local org_new_psi_storm_time = psi_storm_manager.CPsiStormManager.new_psi_storm_time
            psi_storm_manager.CPsiStormManager.new_psi_storm_time = function(self, reset)
                org_new_psi_storm_time(self, reset)
                if not rtz_mcm.get_config("enabled") then return end
                local sm = surge_manager and surge_manager.get_surge_manager and surge_manager.get_surge_manager()
                roll_emission_delta(true, self, sm)
                if not self.started and game and game.get_game_time then
                    self.inited_time = game.get_game_time()
                end
            end
        end

        if psi_storm_manager.CPsiStormManager.start then
            local org_psi_start = psi_storm_manager.CPsiStormManager.start
            psi_storm_manager.CPsiStormManager.start = function(self, manual)
                if rtz_mcm.get_config("enabled") and not self.started then
                    if game and game.get_game_time then
                        self.inited_time = game.get_game_time()
                    end
                    return org_psi_start(self, true)
                end
                return org_psi_start(self, manual)
            end
        end

        -- Wrap CPsiStormManager.finish so lingering psi-storm weather FX stops immediately
        if psi_storm_manager.CPsiStormManager.finish then
            local org_psi_finish = psi_storm_manager.CPsiStormManager.finish
            psi_storm_manager.CPsiStormManager.finish = function(self, manual)
                org_psi_finish(self, manual)
                if rtz_mcm.get_config("enabled") then
                    pcall(function()
                        if level and level.is_wfx_playing and level.is_wfx_playing() then
                            level.stop_weather_fx()
                        end
                        if level_weathers and level_weathers.get_weather_manager then
                            local wm = level_weathers.get_weather_manager()
                            if wm and wm.forced_weather_change then
                                wm:forced_weather_change()
                            end
                        end
                    end)
                    enforce_time_factor()
                    sync_to_real_time(true)
                end
            end
        end
    end

    -- Hook ZCP (Survival Mode Remade / smr_pop.smart_can_respawn) if present
    if smr_pop and smr_pop.smart_can_respawn then
        local org_smart_can_respawn = smr_pop.smart_can_respawn
        smr_pop.smart_can_respawn = function(smart)
            if not rtz_mcm.get_config("enabled") or not rtz_mcm.get_config("vanilla_vitals_alife_scale") then
                return org_smart_can_respawn(smart)
            end
            if not smart or smart.last_respawn_update == nil then
                return org_smart_can_respawn(smart)
            end

            local ratio = get_vanilla_scale_ratio()
            if smr_amain_mcm and smr_amain_mcm.get_config then
                local smr_enabled = smr_amain_mcm.get_config("smr_enabled")
                local cfg = smr_amain_mcm.get_config("respawn_idle")
                if not smr_enabled and cfg ~= 86400 then
                    local base_idle = smart.__rtz_base_respawn_idle or smart.respawn_idle or 86400
                    return game.get_game_time():diffSec(smart.last_respawn_update) > (base_idle * ratio)
                end
                if cfg == -1 then
                    return false
                end
                if type(cfg) == "number" and cfg > 0 then
                    local diff = game.get_game_time():diffSec(smart.last_respawn_update)
                    return diff > (cfg * ratio)
                end
            end
            return org_smart_can_respawn(smart)
        end
        printf_rtz("Hooked smr_pop.smart_can_respawn for vanilla real-time A-Life respawn pacing.")
    end
end

-- =======================================================================================
-- Real-Time Clock Synchronization
-- =======================================================================================

local function is_emission_or_wfx_active()
    if level and level.is_wfx_playing and level.is_wfx_playing() then return true end
    if surge_manager and surge_manager.is_started and surge_manager.is_started() then return true end
    if psi_storm_manager and psi_storm_manager.is_started and psi_storm_manager.is_started() then return true end
    return false
end

--- Computes forward difference in seconds (0..86399) and signed difference (-43200..+43200)
local function get_clock_diff_seconds()
    local real = os.date("*t")
    if not real then return 0, nil, 0 end

    local real_sec = real.hour * 3600 + real.min * 60 + real.sec
    local game_h, game_m, game_s = get_game_hms()
    local game_sec = game_h * 3600 + game_m * 60 + game_s

    -- Signed shortest distance on the 24h circle (-43200 .. +43200)
    -- Positive: game clock is behind real time. Negative: game clock is ahead of real time.
    local signed_diff = (real_sec - game_sec) % 86400
    if signed_diff > 43200 then
        signed_diff = signed_diff - 86400
    end

    -- Because level.change_game_time only takes whole minutes (hours, mins) and cannot adjust seconds,
    -- if the clock is within [-90s, +60s] of real time, it is already synced to the current minute!
    if signed_diff >= -90 and signed_diff < 60 then
        return 0, real, signed_diff
    end

    local forward_diff = (real_sec - game_sec) % 86400
    return forward_diff, real, signed_diff
end

--- Synchronizes the in-game clock directly with real OS wall clock
function sync_to_real_time(force)
    if not rtz_mcm.get_config("enabled") or not rtz_mcm.get_config("sync_clock") then
        return
    end

    -- Never jump the clock while an emission, psi-storm, or weather FX is active
    if is_emission_or_wfx_active() then
        return
    end

    local diff_sec, real, signed_diff = get_clock_diff_seconds()
    if not real or diff_sec < 60 then
        is_synced = true
        return
    end

    -- If the game clock is slightly ahead of real time (up to 4 hours ahead, e.g. after an emission at
    -- time_factor = 10 or Fair Fast Travel), do NOT jump +20..23 hours forward and cost a day!
    -- Instead, enforce_time_factor() slows the game clock until the wall clock catches up.
    if signed_diff < -60 and signed_diff >= -14400 then
        printf_rtz("Game clock is %d mins ahead of wall clock; holding/slowing time factor instead of jumping +23h.", math.floor(-signed_diff / 60))
        is_synced = true
        return
    end

    local game_h, game_m, game_s = get_game_hms()

    -- Calculate exact whole hours & minutes to land on real.hour : real.min
    local total_mins = (real.hour * 60 + real.min) - (game_h * 60 + game_m)
    if total_mins <= 0 then
        total_mins = total_mins + 1440
    end
    local hours = math.floor(total_mins / 60)
    local mins  = total_mins % 60

    if level and level.change_game_time then
        change_game_time_guarded(0, hours, mins)

        printf_rtz("In-game clock synchronized (vitals guarded): was %02d:%02d:%02d -> now %02d:%02d (+%d hrs, +%d mins)",
            game_h, game_m, game_s, real.hour, real.min, hours, mins)

        if actor_menu and actor_menu.set_msg then
            local time_str = string.format("%02d:%02d", real.hour, real.min)
            actor_menu.set_msg(1, string.format(game.translate_string("st_rtz_clock_synced"), time_str), 4)
        end
    end

    is_synced = true
end

--- Enforces target time factor (1.0 default, or 0.1 catch-up hold when game clock is ahead of wall clock)
function enforce_time_factor()
    if not rtz_mcm.get_config("enabled") or not rtz_mcm.get_config("lock_time_factor") then
        return
    end

    -- Do not override during active surge/psi-storm FX
    if is_emission_or_wfx_active() then return end

    local target_tf = rtz_mcm.get_config("time_factor_val") or 1.0

    -- If clock sync is enabled and game clock is 1.5 mins to 4 hours ahead of wall clock (e.g. post-emission),
    -- slow the game clock to 0.1x so the wall clock catches up without jumping a full day forward
    if rtz_mcm.get_config("sync_clock") then
        local _, _, signed_diff = get_clock_diff_seconds()
        if signed_diff and signed_diff < -90 and signed_diff >= -14400 then
            target_tf = math.min(target_tf, 0.1)
        end
    end

    local cur_tf = level.get_time_factor()
    if math.abs(cur_tf - target_tf) > 0.05 then
        level.set_time_factor(target_tf)
    end
end

function init()
    install_alife_hooks()
    scale_initial_emission_deltas()
    enforce_time_factor()
    sync_to_real_time(true)
    sync_thirst_and_sleep_intervals()
    patch_external_time_elapsed_mods()
end

function update()
    local tg = time_global()
    enforce_time_factor()
    update_boosters_and_effects(tg)
    update_vanilla_hunger_drain(tg)

    if tg > last_drift_check + DRIFT_CHECK_MS then
        last_drift_check = tg
        -- Drift check: verify if loading/menu pauses or an emission left the clock behind real time
        if rtz_mcm.get_config("enabled") and rtz_mcm.get_config("sync_clock") and not is_emission_or_wfx_active() then
            local _, _, signed_diff = get_clock_diff_seconds()
            -- Skip while bleeding or irradiated so a long menu pause can't drain a large chunk of health at once
            local hurt = db.actor and ((db.actor.bleeding or 0) > 0 or (db.actor.radiation or 0) > 0)
            if signed_diff and signed_diff >= 90 and signed_diff <= 14400 and not hurt then
                change_game_time_guarded(0, 0, math.floor(signed_diff / 60))
            end
        end
    end
end
