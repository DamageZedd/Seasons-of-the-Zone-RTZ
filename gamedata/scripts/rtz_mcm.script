-- =======================================================================================
-- Real Time Zone (RTZ) - MCM Configuration Module
-- Addon for Seasons of the Zone by Denis_Zedd
-- =======================================================================================

local defaults = {
    ["enabled"]                    = true,
    ["sync_clock"]                 = true,
    ["lock_time_factor"]           = true,
    ["time_factor_val"]            = 1.0,
    ["safeguard_vitals"]           = true,
    ["vanilla_vitals_alife_scale"] = true,
    ["enable_real_weather"]        = true,
    ["weather_sync_interval"]      = 5,
    ["enable_realtime_rest"]       = true,
    ["rest_duration"]              = 5,
    ["enable_campfire_rest"]       = true,
    ["campfire_rest_rate"]         = 20,
    ["wake_on_danger"]             = true,
    ["autosave_on_rest"]           = true,
}

function get_config(key)
    if ui_mcm then
        local v = ui_mcm.get("rtz/" .. key)
        if v ~= nil then
            if key == "rest_duration" and type(v) == "number" and v > 10 then
                return defaults[key]
            end
            return v
        end
    end
    return defaults[key]
end

function on_mcm_load()
    return {
        id = "rtz",
        sh = true,
        gr = {
            { id = "title", type = "slide", link = "ui_options_slider_player", text = "ui_mcm_rtz_title", size = {512, 50}, spacing = 20 },
            { id = "desc", type = "desc", text = "ui_mcm_rtz_desc", clr = {255, 180, 180, 180} },
            { id = "enabled", type = "check", val = 1, def = defaults["enabled"] },

            -- 1. Clock & Time Synchronization
            { id = "divider_clock", type = "line" },
            { id = "header_clock", type = "desc", text = "ui_mcm_rtz_header_clock", clr = {255, 238, 155, 20} },
            { id = "sync_clock", type = "check", val = 1, def = defaults["sync_clock"] },
            { id = "lock_time_factor", type = "check", val = 1, def = defaults["lock_time_factor"] },
            { id = "time_factor_val", type = "track", val = 2, min = 1.0, max = 10.0, step = 0.5, def = defaults["time_factor_val"] },
            { id = "safeguard_vitals", type = "check", val = 1, def = defaults["safeguard_vitals"] },
            { id = "vanilla_vitals_alife_scale", type = "check", val = 1, def = defaults["vanilla_vitals_alife_scale"] },

            -- 2. Live Real-World Weather
            { id = "divider_weather", type = "line" },
            { id = "header_weather", type = "desc", text = "ui_mcm_rtz_header_weather", clr = {255, 238, 155, 20} },
            { id = "enable_real_weather", type = "check", val = 1, def = defaults["enable_real_weather"] },
            { id = "weather_sync_interval", type = "track", val = 2, min = 1, max = 30, step = 1, def = defaults["weather_sync_interval"] },

            -- 3. Real-Time Resting (Sleep Replacement)
            { id = "divider_rest", type = "line" },
            { id = "header_rest", type = "desc", text = "ui_mcm_rtz_header_rest", clr = {255, 238, 155, 20} },
            { id = "enable_realtime_rest", type = "check", val = 1, def = defaults["enable_realtime_rest"] },
            { id = "rest_duration", type = "track", val = 2, min = 1, max = 10, step = 1, def = defaults["rest_duration"] },
            { id = "enable_campfire_rest", type = "check", val = 1, def = defaults["enable_campfire_rest"] },
            { id = "campfire_rest_rate", type = "track", val = 2, min = 5, max = 50, step = 5, def = defaults["campfire_rest_rate"] },
            { id = "wake_on_danger", type = "check", val = 1, def = defaults["wake_on_danger"] },
            { id = "autosave_on_rest", type = "check", val = 1, def = defaults["autosave_on_rest"] },
        }
    }
end
